# Required existing settings (fill in Render's Environment page; never commit real values)
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
OWNER_TELEGRAM_ID=
# Optional comma-separated numeric Telegram user IDs allowed to review/manage the bot.
LEADER_TELEGRAM_IDS=

# Existing optional settings
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_PER_MODEL_RPM_LIMIT=15
GEMINI_PER_MODEL_RPD_LIMIT=500
MAX_MEDIA_MB=15
CONTEXT_MESSAGES=20
ALLOWED_GROUP_ID=
AUTO_FAQ_REPLY=true
FAQ_CONFIDENCE_THRESHOLD=0.85
ALLOW_LOCAL_DB=0

# College announcement ingestion. Use numeric Telegram chat IDs, not invite links.
# Add the bot as an administrator to the news channel so Telegram sends channel posts.
NEWS_CHANNEL_ID=
# Numeric ID of the discussion group where approved summaries may be published.
DISCUSSION_GROUP_ID=
